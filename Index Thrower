<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Stylish Bungalow | Luxury Vacation Rental | Little Rock</title>

<meta name="description" content="Luxury vacation rental in Little Rock featuring a private hot tub, fire pit, chef kitchen, fast WiFi, and convenient access to downtown and local hospitals.">

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>

:root{
--primary:#8AA17D;
--gold:#B89B5E;
--dark:#232323;
--light:#FAF7F2;
--white:#ffffff;
}

*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
font-family:'Inter',sans-serif;
background:var(--light);
color:var(--dark);
line-height:1.6;
}

h1,h2,h3{
font-family:'Playfair Display',serif;
}

a{
text-decoration:none;
color:inherit;
}

.navbar{
position:fixed;
top:0;
width:100%;
background:rgba(255,255,255,.95);
display:flex;
justify-content:space-between;
align-items:center;
padding:20px 8%;
z-index:999;
box-shadow:0 0 10px rgba(0,0,0,.08);
}

.logo{
font-size:1.5rem;
font-weight:700;
}

.nav-links{
display:flex;
gap:30px;
}

.hero{
height:100vh;
background:
linear-gradient(rgba(0,0,0,.45),rgba(0,0,0,.45)),
url('https://images.unsplash.com/photo-1564013799919-ab600027ffc6?auto=format&fit=crop&w=1800&q=80');
background-size:cover;
background-position:center;
display:flex;
align-items:center;
justify-content:center;
text-align:center;
color:white;
padding:20px;
}

.hero-content{
max-width:900px;
}

.hero h1{
font-size:4rem;
margin-bottom:20px;
}

.hero p{
font-size:1.25rem;
margin-bottom:30px;
}

.btn{
display:inline-block;
padding:16px 34px;
background:var(--gold);
color:white;
font-weight:600;
border-radius:50px;
transition:.3s;
}

.btn:hover{
transform:translateY(-2px);
}

.section{
padding:90px 8%;
}

.section-title{
text-align:center;
margin-bottom:50px;
font-size:2.5rem;
}

.features{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:25px;
}

.feature-card{
background:white;
padding:30px;
border-radius:16px;
box-shadow:0 6px 20px rgba(0,0,0,.08);
text-align:center;
}

.feature-card h3{
margin-bottom:10px;
}

.gallery{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
gap:15px;
}

.gallery img{
width:100%;
height:280px;
object-fit:cover;
border-radius:14px;
}

.about{
display:grid;
grid-template-columns:1fr 1fr;
gap:60px;
align-items:center;
}

.about img{
width:100%;
border-radius:16px;
}

.highlights{
background:white;
}

.stats{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:30px;
text-align:center;
}

.stat{
padding:30px;
}

.stat h2{
font-size:2.8rem;
color:var(--primary);
}

.review-grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
gap:25px;
}

.review{
background:white;
padding:30px;
border-radius:16px;
box-shadow:0 4px 14px rgba(0,0,0,.08);
}

.booking-section{
background:var(--primary);
color:white;
}

.booking-form{
max-width:650px;
margin:auto;
display:grid;
gap:15px;
}

.booking-form input,
.booking-form textarea{
padding:15px;
border:none;
border-radius:10px;
font-family:inherit;
}

.booking-form button{
background:var(--gold);
color:white;
padding:15px;
border:none;
border-radius:10px;
font-weight:600;
cursor:pointer;
}

.footer{
background:#1b1b1b;
color:white;
padding:50px 8%;
text-align:center;
}

@media(max-width:768px){

.hero h1{
font-size:2.7rem;
}

.about{
grid-template-columns:1fr;
}

.nav-links{
display:none;
}

.stats{
grid-template-columns:repeat(2,1fr);
}
}

</style>
</head>
